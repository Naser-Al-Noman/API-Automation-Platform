# Neon Postgres connection string (use the pooled connection for serverless/PaaS)
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Long random string used to sign JWTs (required in production)
JWT_SECRET=change-me-to-a-long-random-string

# HTTP port — locally defaults to 5000; Render injects PORT automatically
PORT=5000

# Allowed browser origin(s) for CORS (comma-separated, no trailing slash)
# Local: http://localhost:5173
# Prod:  https://your-app.vercel.app
# Both:  https://your-app.vercel.app,https://your-app-git-main-xxx.vercel.app
FRONTEND_URL=http://localhost:5173
